# ---- Server ----
PORT=4000

# ---- MongoDB ----
# Local: mongodb://127.0.0.1:27017/book_reader
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/book_reader
MONGO_URI=mongodb://127.0.0.1:27017/book_reader

# ---- AI explain feature (apmix.ai, Anthropic-compatible API) ----
AI_BASE_URL=https://api.apmix.ai
AI_API_KEY=your-apmix-api-key-here
AI_MODEL=claude-sonnet-4-6-free

# ---- File storage on Vercel ----
# Required ONLY when deployed on Vercel (its filesystem is read-only/ephemeral,
# so uploaded books are stored in Vercel Blob instead of on disk).
# Leave this unset for local development — it will fall back to saving files
# in server/uploads/ instead.
# Get this value from: Vercel dashboard -> your project -> Storage -> Blob -> Connect.
# Vercel also auto-injects it as an env var once you connect the Blob store, so you
# usually don't need to paste it manually when deployed.
BLOB_READ_WRITE_TOKEN=
